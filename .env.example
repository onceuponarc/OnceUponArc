NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ONCEUPON_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43147
# Production site: https://once-upon-arc.vercel.app
# Optional: override Solana RPC. Defaults to public mainnet-beta (rate-limited).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Jupiter overrides. Defaults to lite-api.jup.ag (no key).
# JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
# JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap
# Optional extra entropy for embedded-wallet encryption. Falls back to the service role.
EMBEDDED_WALLET_SECRET=
# Optional IPFS pin so coin art is an ipfs:// CID (Pinata JWT or NFT.Storage token).
# Without this, covers are stored in the public Supabase `covers` bucket.
PINATA_JWT=
# NFT_STORAGE_TOKEN=
